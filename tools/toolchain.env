# The pinned build environment, read by the Makefile (include), tools/package.sh, tools/release_dry.sh
# and the CI workflow (.github/workflows/build.yml copies the KEY=value lines into $GITHUB_ENV).
# KEY=value lines only (no quotes, no spaces): make, bash and GitHub read the same file.
# A3 (BUG-1121): the llvm-mingw tarball CI downloads must have this SHA-256 (GitHub's asset digest for
# llvm-mingw-<version>-ucrt-ubuntu-22.04-x86_64.tar.xz, checked against a download on 2026-11-15; the
# local ~/.local/opt copy had the same 7421 files, byte for byte).
LLVM_MINGW_VERSION=20261006
LLVM_MINGW_SHA256=5f9c6ed95b2d4bdb2869a488c5fd5857fbdabcf288a0aa3eb1da43f6a08d8ab4
# the Python of the CI runner (ubuntu-22.04): the tools must parse and run on it (docs/06-testing.md#testing-ci-python310)
CI_PYTHON=3.10
# the setup's icon (tools/make_ico.py); 12.3.0 supports Python 3.10
PILLOW_VERSION=12.3.0
